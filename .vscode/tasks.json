{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "make: build",
            "command": "make",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Default release build (hikari + hikari-unlocker)."
        },
        {
            "type": "shell",
            "label": "make: build (debug)",
            "command": "make",
            "args": ["DEBUG=YES"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build",
            "detail": "Debug build (-g, asserts enabled, wlr_log_init(WLR_DEBUG)) -- used by the debug launch configs."
        },
        {
            "type": "shell",
            "label": "make: build (full feature)",
            "command": "make",
            "args": ["WITH_ALL=YES", "DEBUG=YES"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build",
            "detail": "Debug build with XWayland, screencopy, gamma control, layer shell, and virtual input enabled."
        },
        {
            "type": "shell",
            "label": "make: clean",
            "command": "make",
            "args": ["clean"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "build"
        },
        {
            "type": "shell",
            "label": "clang-format: check",
            "command": "clang-format",
            "args": ["--dry-run", "--Werror", "*.c", "src/*.c", "include/hikari/*.h"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "test",
            "detail": "TC-FORMAT-01: verify .clang-format compliance without modifying files."
        },
        {
            "type": "shell",
            "label": "clang-format: apply",
            "command": "clang-format",
            "args": ["-i", "*.c", "src/*.c", "include/hikari/*.h"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "none",
            "detail": "Reformat all sources and headers in place per .clang-format."
        }
    ]
}
